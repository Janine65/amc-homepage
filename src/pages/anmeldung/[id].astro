---
import Layout from '../../layouts/Layout.astro';
import Turnstile from '../../components/Turnstile.astro';
import { getAgenda, getTurnstileSiteKey, postAnmeldung, formatDatum } from '../../lib/api';

const { id } = Astro.params;
const agenda = (await getAgenda()) ?? [];
const anlass = agenda.find((a) => a.id === Number(id) && !a.istkegeln && !a.istmotorrad);

let result: { ok: boolean; message: string } | null = null;
let form: FormData | null = null;

if (Astro.request.method === 'POST' && anlass) {
  form = await Astro.request.formData();
  result = await postAnmeldung({
    anlassid: anlass.id,
    name: String(form.get('name') ?? ''),
    vorname: String(form.get('vorname') ?? ''),
    email: String(form.get('email') ?? ''),
    bemerkung: String(form.get('bemerkung') ?? '') || undefined,
    website: String(form.get('website') ?? '') || undefined,
    turnstile_token: String(form.get('cf-turnstile-response') ?? ''),
  });
}

const siteKey = anlass && !result?.ok ? await getTurnstileSiteKey() : null;
---

<Layout title="Anmeldung">
  {!anlass && (
    <>
      <h1>Anlass nicht gefunden</h1>
      <p class="hinweis">Dieser Anlass existiert nicht, liegt in der Vergangenheit oder benötigt keine Anmeldung.</p>
      <a class="btn" href="/agenda">Zur Agenda</a>
    </>
  )}
  {anlass && (
    <>
      <h1>Anmeldung: {anlass.name}</h1>
      <p class="datum">{formatDatum(anlass.datum)}</p>
      {anlass.beschreibung && <p>{anlass.beschreibung}</p>}

      {result && <div class:list={['alert', result.ok ? 'ok' : 'error']}>{result.message}</div>}
      {!result?.ok && !siteKey && (
        <p class="alert error">Der Spam-Schutz ist derzeit nicht verfügbar. Bitte versuche es später erneut.</p>
      )}

      {!result?.ok && siteKey && (
        <form method="POST" class="card">
          <label for="vorname">Vorname *</label>
          <input id="vorname" name="vorname" required maxlength="100" value={String(form?.get('vorname') ?? '')} />

          <label for="name">Nachname *</label>
          <input id="name" name="name" required maxlength="100" value={String(form?.get('name') ?? '')} />

          <label for="email">E-Mail *</label>
          <input id="email" name="email" type="email" required maxlength="255" value={String(form?.get('email') ?? '')} />

          <label for="bemerkung">Bemerkung</label>
          <textarea id="bemerkung" name="bemerkung" rows="3" maxlength="500">{String(form?.get('bemerkung') ?? '')}</textarea>

          <div class="honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <Turnstile siteKey={siteKey} action="anmeldung" submitLabel="Anmelden" />
        </form>
      )}
      {result?.ok && <a class="btn" href="/agenda">Zur Agenda</a>}
    </>
  )}
</Layout>
