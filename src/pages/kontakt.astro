---
import Layout from '../layouts/Layout.astro';
import { getTurnstileSiteKey, postKontakt } from '../lib/api';

let result: { ok: boolean; message: string } | null = null;
let form: FormData | null = null;

if (Astro.request.method === 'POST') {
  form = await Astro.request.formData();
  result = await postKontakt({
    name: String(form.get('name') ?? ''),
    vorname: String(form.get('vorname') ?? ''),
    email: String(form.get('email') ?? ''),
    betreff: String(form.get('betreff') ?? ''),
    nachricht: String(form.get('nachricht') ?? ''),
    website: String(form.get('website') ?? '') || undefined,
    turnstile_token: String(form.get('cf-turnstile-response') ?? ''),
  });
}

const siteKey = result?.ok ? null : await getTurnstileSiteKey();
---

<Layout title="Kontakt">
  <h1>Kontakt</h1>
  <p>Hast du Fragen zum Club oder zu unseren Anlässen? Schreibe uns – wir melden uns gerne bei dir.</p>

  {result && <div class:list={['alert', result.ok ? 'ok' : 'error']}>{result.message}</div>}
  {!result?.ok && !siteKey && (
    <p class="alert error">Der Spam-Schutz ist derzeit nicht verfügbar. Bitte versuche es später erneut.</p>
  )}

  {!result?.ok && siteKey && (
    <form method="POST" class="card">
      <label for="vorname">Vorname *</label>
      <input id="vorname" name="vorname" required maxlength="100" value={String(form?.get('vorname') ?? '')} />

      <label for="name">Nachname *</label>
      <input id="name" name="name" required maxlength="100" value={String(form?.get('name') ?? '')} />

      <label for="email">E-Mail *</label>
      <input id="email" name="email" type="email" required maxlength="255" value={String(form?.get('email') ?? '')} />

      <label for="betreff">Betreff *</label>
      <input id="betreff" name="betreff" required maxlength="200" value={String(form?.get('betreff') ?? '')} />

      <label for="nachricht">Nachricht *</label>
      <textarea id="nachricht" name="nachricht" rows="6" required maxlength="5000">{String(form?.get('nachricht') ?? '')}</textarea>

      <p class="hinweis">
        Zum Schutz vor Spam verwenden wir Cloudflare Turnstile. Dabei werden technische
        Verbindungs- und Browserdaten durch Cloudflare verarbeitet, gegebenenfalls auch
        ausserhalb der Schweiz und des EWR.
        Weitere Informationen findest du in der
        <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Datenschutzerklärung von Cloudflare</a>.
      </p>
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action="kontakt"
        data-language="de"
        data-size="flexible"
        data-callback="contactTurnstileSuccess"
        data-expired-callback="contactTurnstileExpired"
        data-error-callback="contactTurnstileError"
        data-timeout-callback="contactTurnstileExpired"
      ></div>
      <p id="turnstile-status" role="status" aria-live="polite">Sicherheitsprüfung wird geladen …</p>
      <noscript><p class="alert error">Bitte aktiviere JavaScript, um die Sicherheitsprüfung abzuschliessen.</p></noscript>

      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <p><button id="kontakt-submit" class="btn" type="submit" disabled>Senden</button></p>
    </form>
  )}
  {result?.ok && <a class="btn" href="/">Zur Übersicht</a>}
  {!result?.ok && siteKey && (
    <>
      <script is:inline>
        function setContactTurnstileState(ready, message) {
          document.getElementById('kontakt-submit').disabled = !ready;
          document.getElementById('turnstile-status').textContent = message;
        }
        window.contactTurnstileSuccess = function () {
          setContactTurnstileState(true, 'Sicherheitsprüfung abgeschlossen.');
        };
        window.contactTurnstileExpired = function () {
          setContactTurnstileState(false, 'Sicherheitsprüfung abgelaufen. Bitte erneut abschliessen.');
        };
        window.contactTurnstileError = function () {
          setContactTurnstileState(false, 'Sicherheitsprüfung nicht verfügbar. Bitte prüfe deine Verbindung oder lade die Seite erneut.');
        };
      </script>
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
        onerror="window.contactTurnstileError()"
      ></script>
    </>
  )}
</Layout>
