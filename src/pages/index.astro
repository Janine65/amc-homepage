---
import Layout from '../layouts/Layout.astro';
import AgendaEintrag from '../components/AgendaEintrag.astro';
import { getNews, getAgenda, formatDatum } from '../lib/api';

const news = (await getNews()) ?? [];
const agenda = ((await getAgenda()) ?? []).slice(0, 3);
---

<Layout title="News">
  <h1>News</h1>
  {news.length === 0 && <p class="hinweis">Zurzeit keine News.</p>}
  {news.map((n) => (
    <article class="card">
      <h2>{n.titel}</h2>
      <div class="datum">{formatDatum(n.datum)}</div>
      <div set:html={n.text} />
    </article>
  ))}

  {agenda.length > 0 && (
    <section>
      <h1>Nächste Veranstaltungen</h1>
      {agenda.map((a) => <AgendaEintrag anlass={a} />)}
      <p><a href="/agenda">Alle Veranstaltungen ansehen →</a></p>
    </section>
  )}
</Layout>
