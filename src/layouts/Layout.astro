---
import pkg from '../../package.json';

interface Props {
  title?: string;
}
const { title = 'AMC Swissair' } = Astro.props;
const nav = [
  { href: '/', label: 'News' },
  { href: '/berichte', label: 'Berichte' },
  { href: '/agenda', label: 'Agenda' },
  { href: '/meisterschaft', label: 'Meisterschaft' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} – Auto-Moto-Club Swissair</title>
    <meta name="description" content="Auto-Moto-Club Swissair – News, Berichte, Agenda und Meisterschaften" />
  </head>
  <body>
    <header>
      <div class="container">
        <a class="brand" href="/">
          <img src="/AMCfarbigKlein.jpg" alt="AMC Swissair Wappen" class="logo" />
          AMC Swissair
        </a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: current === item.href }}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <div class="container">© {new Date().getFullYear()} Auto-Moto-Club Swissair · v{pkg.version}</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #1d4ed8;
    --text: #1f2937;
    --muted: #6b7280;
    --bg: #f8fafc;
    --card: #ffffff;
    --border: #e5e7eb;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
  }
  .container { max-width: 960px; margin: 0 auto; padding: 0 1rem; }
  header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
  }
  header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: 3.5rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo {
    height: 2.6rem;
    width: auto;
  }
  nav { display: flex; gap: 1rem; }
  nav a { color: var(--text); text-decoration: none; padding: 0.25rem 0; }
  nav a.active, nav a:hover { color: var(--primary); border-bottom: 2px solid var(--primary); }
  main { padding: 2rem 1rem; min-height: 60vh; }
  footer { border-top: 1px solid var(--border); padding: 1rem 0; color: var(--muted); font-size: 0.9rem; }
  h1 { margin-top: 0; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .card h2 { margin: 0 0 0.25rem; font-size: 1.15rem; }
  .datum { color: var(--muted); font-size: 0.85rem; }
  table { width: 100%; border-collapse: collapse; background: var(--card); }
  th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
  th { background: var(--bg); }
  .btn {
    display: inline-block;
    background: var(--primary);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: none;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover { opacity: 0.9; }
  .hinweis { color: var(--muted); }
  .alert { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .alert.ok { background: #dcfce7; color: #166534; }
  .alert.error { background: #fee2e2; color: #991b1b; }
  form label { display: block; font-weight: 600; margin-top: 0.75rem; }
  form input, form textarea {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
    font-family: inherit;
  }
  .honeypot { position: absolute; left: -9999px; }
</style>
