---
import Layout from '../layouts/Layout.astro';
import AgendaEintrag from '../components/AgendaEintrag.astro';
import { getNews, formatDatum } from '../lib/api';

const news = (await getNews()) ?? [];
---

<Layout title="News">
  <h1>News</h1>
  {news.length === 0 && <p class="hinweis">Zurzeit keine News.</p>}
  {news.map((n) => (
    <article class="card">
      <h2>{n.titel}</h2>
      <div class="datum">{formatDatum(n.datum)}</div>
      <div set:html={n.text} />
    </article>
  ))}

  <!-- No agenda section on the news page -->
</Layout>
